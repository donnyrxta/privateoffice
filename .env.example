# SHA-256 hex digest of a random one-time office setup secret.
OFFICE_SETUP_HASH=

# Standalone Cloudflare build. The build script sets this automatically.
PRIVATE_OFFICE_STANDALONE=1

# D1 database ID exposed to Workers Builds while Vinext generates the deployment config.
CLOUDFLARE_D1_DATABASE_ID=

# Cloudflare Access runtime verification.
CF_ACCESS_TEAM_DOMAIN=https://your-team.cloudflareaccess.com
CF_ACCESS_AUD=
